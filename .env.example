TASKFORGE_PROVIDER=demo
# Fresh checkouts keep SQLite as the safe local default. The current working
# copy uses PostgreSQL in its ignored `.env`; set the three PostgreSQL values
# below when using the migrated runtime.
TASKFORGE_DATABASE_BACKEND=sqlite
TASKFORGE_DATABASE_URL=
# PostgreSQL example after the local/Compose gates pass:
# TASKFORGE_DATABASE_BACKEND=postgres
# Host-side migration/verification DSN; Compose injects the internal `postgres` hostname.
# TASKFORGE_DATABASE_URL=postgresql://taskforge_app:<TASKFORGE_POSTGRES_TASKFORGE_PASSWORD>@localhost:5432/taskforge
TASKFORGE_POSTGRES_ADMIN_PASSWORD=
TASKFORGE_POSTGRES_TASKFORGE_PASSWORD=
TASKFORGE_POSTGRES_PATCHPILOT_PASSWORD=
TASKFORGE_POSTGRES_DATA_ROOT=D:/TaskForge/postgres
TASKFORGE_POSTGRES_POOL_MIN_SIZE=1
TASKFORGE_POSTGRES_POOL_MAX_SIZE=8
TASKFORGE_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
TASKFORGE_SQLITE_PATH=.taskforge/taskforge.sqlite3
TASKFORGE_CONTEXT_SQLITE_PATH=.taskforge/context.sqlite3
TASKFORGE_OPERATIONS_SQLITE_PATH=.taskforge/operations.sqlite3
TASKFORGE_ORCHESTRATION_SQLITE_PATH=.taskforge/orchestration.sqlite3
TASKFORGE_REVIEW_CASE_SQLITE_PATH=.taskforge/review-cases.sqlite3
TASKFORGE_CONTEXT_BACKEND=sqlite
# Live traffic remains on current until the offline A/B gate passes.
TASKFORGE_RAG_ACTIVE_PROFILE=current
# Offline tools may set this to optimized without changing live routing.
TASKFORGE_RAG_EXPERIMENT_PROFILE=current
# A=current control; B=title/section retrieval text; C=Parent-aware rerank;
# D=lineage diversity; E=structure-aware hybrid chunking.
TASKFORGE_RAG_OPTIMIZED_ABLATION=e
# Offline evaluators set this internally. Never enable it for live traffic.
TASKFORGE_RAG_EVALUATION_MODE=false
# Required only after a complete A/B manifest reports eligible_for_canary.
TASKFORGE_RAG_OPTIMIZED_PROMOTION_MANIFEST=
TASKFORGE_RETRIEVAL_ROUTING=profile
# Main dense embedding: keep the evaluated control route until the BGE-M3
# locked20 gate passes. Set these three values to the BGE-M3 candidate below
# only after a new promotion report clears the gates.
TASKFORGE_GENERAL_TEXT_BACKEND=fastembed
TASKFORGE_FASTEMBED_MODEL_CACHE_ROOT=D:/my-coding/TaskForge/.taskforge/model-cache/fastembed
# Control route (FastEmbed/BGE-small); the BGE-M3 candidate remains isolated.
TASKFORGE_SEMANTIC_MODEL=BAAI/bge-small-en-v1.5
TASKFORGE_SEMANTIC_CACHE_PATH=.taskforge/embeddings.sqlite3
# Alibaba Cloud Model Studio (Bailian) candidate. Keep the key blank in this
# template and store the real value only in the gitignored local .env file.
# The public Beijing OpenAI-compatible endpoint works without a Workspace ID;
# a workspace-specific endpoint can replace it later.
TASKFORGE_BAILIAN_API_KEY=
TASKFORGE_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TASKFORGE_BAILIAN_CHAT_MODEL=qwen-plus
TASKFORGE_BAILIAN_CHAT_TIMEOUT_SECONDS=60
TASKFORGE_BAILIAN_CHAT_TRUST_ENV=false
TASKFORGE_BAILIAN_MODEL=text-embedding-v4
TASKFORGE_BAILIAN_EMBEDDING_DIMENSION=1024
TASKFORGE_BAILIAN_BATCH_SIZE=10
TASKFORGE_BAILIAN_TIMEOUT_SECONDS=30
TASKFORGE_BAILIAN_MAX_RETRIES=3
TASKFORGE_BAILIAN_CACHE_PATH=.taskforge/embeddings-bailian-v4-1024.sqlite3
TASKFORGE_BAILIAN_INDEX_NAME=knowledge-bailian-text-embedding-v4-1024-v1
TASKFORGE_BAILIAN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
TASKFORGE_BAILIAN_RERANK_MODEL=qwen3-rerank
TASKFORGE_BAILIAN_RERANK_TIMEOUT_SECONDS=30
TASKFORGE_BAILIAN_RERANK_MAX_RETRIES=2
# BGE-M3 candidate configuration (do not activate until the gate passes):
# TASKFORGE_GENERAL_TEXT_BACKEND=flagembedding
# TASKFORGE_SEMANTIC_MODEL=BAAI/bge-m3
# TASKFORGE_SEMANTIC_MODEL_PATH=D:/my-coding/TaskForge/.taskforge/model-cache/flagembedding/bge-m3-pytorch
# TASKFORGE_SEMANTIC_BATCH_SIZE=8
# TASKFORGE_SEMANTIC_DEVICE=auto
# TASKFORGE_SEMANTIC_CACHE_PATH=.taskforge/embeddings-bge-m3-v1.sqlite3
# Optional CJK/cross-lingual research route. Leave blank to avoid the
# additional local model download; English retrieval remains unchanged.
# The recommended pair is multilingual-e5-large + jina-reranker-v2-base-multilingual.
TASKFORGE_RESEARCH_MULTILINGUAL_SEMANTIC_MODEL=
TASKFORGE_RESEARCH_RERANKER_BACKEND=fastembed_ensemble
TASKFORGE_RESEARCH_RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en,Xenova/ms-marco-MiniLM-L-6-v2
TASKFORGE_RESEARCH_MULTILINGUAL_RERANKER_BACKEND=fastembed
# Optional multilingual cross-encoder; download the full 1.1GB checkpoint
# before enabling it. Missing weights trigger the explicit Flat/RRF fallback.
TASKFORGE_RESEARCH_MULTILINGUAL_RERANKER_MODEL=
TASKFORGE_RESEARCH_RERANKER_DEVICE=auto
TASKFORGE_RESEARCH_RERANKER_BATCH_SIZE=32
# Experimental optimized-only single-pass rerank view. Current ignores it.
TASKFORGE_RESEARCH_CONTEXTUAL_CHILD_RERANK_ENABLED=false
TASKFORGE_RESEARCH_CONTEXTUAL_CHILD_NEIGHBOR_TOKENS=120
TASKFORGE_RESEARCH_CONTEXTUAL_CHILD_MAX_TOKENS=500
TASKFORGE_RESEARCH_PARENT_AWARE_RERANK_ENABLED=true
TASKFORGE_RESEARCH_PARENT_REFERENTIAL_GUARD_ENABLED=true
TASKFORGE_RESEARCH_PARENT_AWARE_CANDIDATE_K=20
TASKFORGE_RESEARCH_PARENT_CONTEXT_MAX_TOKENS=800
TASKFORGE_RESEARCH_PARENT_INCLUDE_DOCUMENT_TITLE=true
TASKFORGE_RESEARCH_PARENT_INCLUDE_HEADING_PATH=true
TASKFORGE_RESEARCH_PARENT_INCLUDE_NEIGHBOR_CHUNKS=true
TASKFORGE_RESEARCH_PARENT_CHILD_SCORE_WEIGHT=0.55
TASKFORGE_RESEARCH_PARENT_CONTEXT_SCORE_WEIGHT=0.35
TASKFORGE_RESEARCH_PARENT_RETRIEVAL_SCORE_WEIGHT=0.10
TASKFORGE_RESEARCH_LINEAGE_DIVERSITY_ENABLED=true
TASKFORGE_RESEARCH_LINEAGE_PREFERRED_CHILDREN_PER_PARENT=2
TASKFORGE_RESEARCH_LINEAGE_PARENT_PENALTY=0.08
TASKFORGE_RESEARCH_LINEAGE_OVERLAP_WEIGHT=0.05
TASKFORGE_RESEARCH_GRAPH_ENABLED=false
TASKFORGE_RESEARCH_REWRITE_ENABLED=false
# Retrieval expansion ablation: original | synonym | full.
TASKFORGE_RESEARCH_QUERY_EXPANSION_MODE=original
# Optional multilingual research route; leave blank to preserve explicit
# multilingual_fallback telemetry without downloading the model pair.
TASKFORGE_RESEARCH_MULTILINGUAL_SEMANTIC_MODEL=
TASKFORGE_RESEARCH_MULTILINGUAL_RERANKER_BACKEND=fastembed
TASKFORGE_RESEARCH_MULTILINGUAL_RERANKER_MODEL=
TASKFORGE_RESEARCH_OPERATOR_BUDGET_STANDARD=1
TASKFORGE_RESEARCH_OPERATOR_BUDGET_RIGOROUS=2
# Optional Flat-primary + Child-auxiliary dual route. Disabled keeps the
# original retrieval chain and its rollback path unchanged.
TASKFORGE_RESEARCH_DUAL_ROUTE_ENABLED=false
TASKFORGE_RESEARCH_DUAL_ROUTE_FLAT_CANDIDATE_K=30
TASKFORGE_RESEARCH_DUAL_ROUTE_CHILD_CANDIDATE_K=20
TASKFORGE_RESEARCH_DUAL_ROUTE_FLAT_HEAD_K=2
# On CPU only this many Dual candidates are sent to the multilingual
# cross-encoder; the remaining candidate tail keeps its retrieval score.
TASKFORGE_RESEARCH_DUAL_ROUTE_RERANK_CANDIDATE_K=10
# Only uncertain visible heads trigger a second pass over this tail budget.
# Set to 0 to keep the single-pass Dual route.
TASKFORGE_RESEARCH_DUAL_ROUTE_TAIL_RERANK_CANDIDATE_K=0
TASKFORGE_RESEARCH_DUAL_ROUTE_MIN_CONFIDENCE=0.35
# PDF parser routing: auto | native | mineru. MinerU stays disabled until a
# sidecar URL and an exact runtime version are both configured.
TASKFORGE_PDF_PARSER_BACKEND=auto
TASKFORGE_MINERU_BASE_URL=
TASKFORGE_MINERU_EXPECTED_VERSION=
# D-drive sidecar defaults to the pipeline bundle: layout/OCR/table/formula.
# hybrid-engine needs MinerU's additional VLM model bundle.
TASKFORGE_MINERU_BACKEND=pipeline
TASKFORGE_MINERU_CACHE_ROOT=D:/my-coding/TaskForge/.taskforge/eval-cache/mineru-shared-v1
TASKFORGE_MINERU_PARSE_METHOD=auto
TASKFORGE_MINERU_EFFORT=high
TASKFORGE_MINERU_CONCURRENCY=2
# Host-side MinerU Compose cache/output root. Keep large downloads on D:.
TASKFORGE_MINERU_DATA_ROOT=D:/TaskForge/mineru
# Optional OpenAI-compatible VLM sidecar. DeepSeek remains text-only; all three
# values are required together. Keep this blank to retain visual_pending.
TASKFORGE_VISUAL_EXTRACTOR_BASE_URL=
TASKFORGE_VISUAL_EXTRACTOR_API_KEY=
TASKFORGE_VISUAL_EXTRACTOR_MODEL=
TASKFORGE_VISUAL_EXTRACTOR_TIMEOUT_SECONDS=120
TASKFORGE_VISUAL_EXTRACTOR_CONCURRENCY=2
TASKFORGE_PDF_PARENT_TARGET_TOKENS=2000
TASKFORGE_PDF_PARENT_MAX_TOKENS=3000
TASKFORGE_PDF_CHILD_TARGET_TOKENS=400
TASKFORGE_PDF_CHILD_MAX_TOKENS=500
TASKFORGE_PDF_CHILD_OVERLAP_TOKENS=60
TASKFORGE_PDF_CHUNKING_MODE=parent_child
# Set to hybrid only for an opt-in dual-lane index; it stores Flat plus
# Parent/Child chunks in the same document version.
TASKFORGE_PDF_FLAT_CHUNK_CHARS=2000
TASKFORGE_PDF_FLAT_OVERLAP_CHARS=0
TASKFORGE_WORKSPACE_ROOT=.
TASKFORGE_ARTIFACT_ROOT=.taskforge/artifacts
TASKFORGE_WORKER_LEASE_SECONDS=30
TASKFORGE_WORKER_MAX_ATTEMPTS=3
# Optional host-owned JSON file. Remote MCP is disabled when this is blank.
TASKFORGE_MCP_CONFIG_PATH=
TASKFORGE_OPENAI_API_KEY=
TASKFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
TASKFORGE_OPENAI_MODEL=
TASKFORGE_OPENAI_TIMEOUT_SECONDS=30
TASKFORGE_DEEPSEEK_API_KEY=
TASKFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
TASKFORGE_DEEPSEEK_MODEL=
TASKFORGE_DEEPSEEK_TIMEOUT_SECONDS=30
TASKFORGE_DEEPSEEK_TRUST_ENV=true
# Strongly recommended for polite scholarly API identification. A formal
# Semantic Scholar key is required for meaningful 100-query live evaluation.
TASKFORGE_LITERATURE_CONTACT_EMAIL=
TASKFORGE_SEMANTIC_SCHOLAR_API_KEY=
TASKFORGE_OPENALEX_API_KEY=
