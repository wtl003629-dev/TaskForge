TASKFORGE_PROVIDER=demo
TASKFORGE_SQLITE_PATH=.taskforge/taskforge.sqlite3
TASKFORGE_CONTEXT_SQLITE_PATH=.taskforge/context.sqlite3
TASKFORGE_OPERATIONS_SQLITE_PATH=.taskforge/operations.sqlite3
TASKFORGE_ORCHESTRATION_SQLITE_PATH=.taskforge/orchestration.sqlite3
TASKFORGE_REVIEW_CASE_SQLITE_PATH=.taskforge/review-cases.sqlite3
TASKFORGE_CONTEXT_BACKEND=sqlite
TASKFORGE_WORKSPACE_ROOT=.
TASKFORGE_ARTIFACT_ROOT=.taskforge/artifacts
TASKFORGE_WORKER_LEASE_SECONDS=30
TASKFORGE_WORKER_MAX_ATTEMPTS=3
# Optional host-owned JSON file. Remote MCP is disabled when this is blank.
TASKFORGE_MCP_CONFIG_PATH=
TASKFORGE_OPENAI_API_KEY=
TASKFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
TASKFORGE_OPENAI_MODEL=
TASKFORGE_OPENAI_TIMEOUT_SECONDS=30
TASKFORGE_DEEPSEEK_API_KEY=
TASKFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
TASKFORGE_DEEPSEEK_MODEL=
TASKFORGE_DEEPSEEK_TIMEOUT_SECONDS=30
